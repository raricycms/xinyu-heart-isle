{
  "name": "xinyu-heart-isle",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "心屿 — 一个温和的心理自助工具站（量表 / 赛博沙盘 / 情绪工具箱 / 心理资源）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "typecheck:all": "tsc -b --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "e2e": "node --experimental-strip-types scripts/e2e/smoke.ts",
    "a11y": "node --experimental-strip-types scripts/audit/a11y.ts",
    "a11y:self-test": "node scripts/audit/meta-self-test.mjs",
    "e2e:self-test": "node scripts/audit/e2e-self-test.mjs",
    "kbd:self-test": "node scripts/audit/keyboard-self-test.mjs",
    "visual": "node scripts/visual-regression.mjs",
    "visual:self-test": "node scripts/audit/visual-self-test.mjs",
    "perf:render": "node scripts/render-perf.mjs",
    "perf:render:self-test": "node scripts/audit/render-perf-self-test.mjs",
    "audit:ghost": "node scripts/audit/ghost-fields.mjs --strict",
    "audit:ghost:self-test": "node scripts/audit/ghost-fields-self-test.mjs",
    "audit:i18n": "node scripts/audit/i18n-dead-keys.mjs --strict",
    "audit:i18n:self-test": "node scripts/audit/i18n-dead-keys-self-test.mjs",
    "audit:css": "node scripts/audit/css-tokens.mjs",
    "audit:css:self-test": "node scripts/audit/css-tokens-self-test.mjs",
    "perf": "node --experimental-strip-types scripts/audit/perf.ts",
    "validate": "node --experimental-strip-types scripts/validate-session.ts",
    "check": "npm run typecheck:all && npm run audit:ghost && npm run audit:i18n && npm run audit:css && npm run build && npm run test && npm run validate -- samples/example.sandplay.json && npm run e2e && npm run visual && npm run perf:render && npm run a11y && npm run perf"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^24.43.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
