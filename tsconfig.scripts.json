{
  "// 说明": "给 scripts/ 下的核查与审计脚本用的类型检查配置。",
  "// 为什么不并进 tsconfig.node.json": "那些脚本在 page.evaluate() 里操作 DOM，需要 dom lib；而 vite.config.ts 是纯 Node 环境，混在一起会让 Node 配置意外获得 DOM 全局（掩盖服务端误用 DOM 的错误）。分开两份更准确。",
  "// 用法": "npx tsc -p tsconfig.scripts.json --noEmit",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["scripts/**/*.ts"]
}
